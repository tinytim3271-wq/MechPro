{
  "id": "mechpro-app",
  "name": "MechPro",
  "short_name": "MechPro",
  "description": "Mobile mechanic shop management platform. Manage repair orders, schedules, invoices, parts, and grow your business.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  },
  "background_color": "#0a0a0f",
  "theme_color": "#e85d26",
  "orientation": "any",
  "categories": ["business", "productivity", "utilities"],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "/icon/icon-192.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon/icon-192.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon/icon-512.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon/icon-512.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "View your mechanic shop dashboard",
      "url": "/dashboard",
      "icons": [{ "src": "/icon/icon-192.png", "sizes": "1024x1024", "type": "image/png" }]
    },
    {
      "name": "Jobs",
      "short_name": "Jobs",
      "description": "Create and manage repair jobs",
      "url": "/jobs",
      "icons": [{ "src": "/icon/icon-192.png", "sizes": "1024x1024", "type": "image/png" }]
    },
    {
      "name": "Schedule",
      "short_name": "Schedule",
      "description": "View and manage your schedule",
      "url": "/schedule",
      "icons": [{ "src": "/icon/icon-192.png", "sizes": "1024x1024", "type": "image/png" }]
    }
  ],
  "screenshots": [
    {
      "src": "/icon/icon-512.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "label": "MechPro Dashboard",
      "form_factor": "wide"
    },
    {
      "src": "/icon/icon-192.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "label": "MechPro Mobile",
      "form_factor": "narrow"
    }
  ],
  "prefer_related_applications": false
}
