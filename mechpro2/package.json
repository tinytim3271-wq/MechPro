{
  "name": "mechpro2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @mechpro/db generate",
    "db:migrate": "pnpm --filter @mechpro/db migrate",
    "db:studio": "pnpm --filter @mechpro/db studio",
    "dev": "pnpm --filter @mechpro/web dev"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2"
  },
  "packageManager": "pnpm@11.7.0"
}
