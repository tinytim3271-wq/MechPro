{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "incremental": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,

    "baseUrl": ".",
    "paths": {
      "@/convex/*": ["./convex/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["./src"],
  "exclude": [
    "./src/pages/app-home",
    "./src/pages/app-about",
    "./src/router.ts",
    "./src/shared.styles.ts",
    "./src/app-index.ts"
  ]
}
