{
  "name": "mechpro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MechPro — mobile mechanic shop management platform",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test src/lib/payrollCalc.test.ts src/lib/roTotals.test.ts src/lib/diagnosticSession.test.ts src/lib/keyProgramming.test.ts src/pages/jobs/_components/printChecklists.test.ts",
    "test:convex": "vitest run",
    "test:aws": "cd aws && npm test",
    "lint": "eslint .",
    "prettier-fix": "prettier --write .",
    "prettier-check": "prettier --check .",
    "cap:sync": "pnpm build && npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron electron/main.mjs\"",
    "electron:build": "pnpm build && electron-builder",
    "deploy:aws": "pnpm build && cd aws && npm run build && npm run cdk:deploy",
    "generate:icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1104.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.883.0",
    "@aws-sdk/client-ses": "^3.1104.0",
    "@capacitor/android": "^7.4.0",
    "@capacitor/app": "^7.0.2",
    "@capacitor/camera": "^7.0.2",
    "@capacitor/core": "^7.4.0",
    "@capacitor/geolocation": "^7.1.5",
    "@capacitor/ios": "^7.4.0",
    "@capacitor/push-notifications": "^7.0.2",
    "@capacitor/splash-screen": "^7.0.2",
    "@capacitor/status-bar": "^7.0.2",
    "@hookform/resolvers": "^5.2.1",
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/react-query": "^5.87.1",
    "@usehercules/sdk": "^1.15.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.26.2",
    "convex-helpers": "^0.1.104",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "escape-html": "^1.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.542.0",
    "motion": "^12.23.12",
    "next-themes": "^0.4.6",
    "oidc-client-ts": "^3.3.0",
    "openai": "^6.48.0",
    "papaparse": "^5.5.4",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "react-day-picker": "^9.9.0",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-leaflet": "^5.0.0",
    "react-oidc-context": "^3.3.0",
    "react-resizable-panels": "^3.0.5",
    "react-router-dom": "^7.8.2",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "use-debounce": "^10.0.6",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@convex-dev/eslint-plugin": "0.0.1-alpha.4",
    "@eslint/js": "^9.35.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.3.1",
    "@types/papaparse": "^5.5.2",
    "@types/escape-html": "^1.0.4",
    "@types/web-push": "^3.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@usehercules/eslint-plugin": "^1.0.14",
    "@usehercules/vite": "^1.0.14",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "concurrently": "^9.2.0",
    "convex-test": "0.0.41",
    "electron": "^35.1.2",
    "electron-builder": "^25.1.8",
    "eslint": "^9.35.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tw-animate-css": "^1.3.8",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.yourcarguy806.mechpro",
    "productName": "MechPro",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg", "category": "public.app-category.business" }
  }
}
