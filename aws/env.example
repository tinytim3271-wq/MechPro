# Lambda / local runtime
DATABASE_URL=postgres://postgres:devpw@localhost:55433/mechpro
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
S3_BUCKET=mechpro-uploads-xxxxx
AWS_REGION=us-east-1
FRONTEND_URL=https://yourcarguy806.com

# AI — production uses AWS Bedrock via Lambda IAM (no API key needed)
AI_PROVIDER=bedrock
AI_MODEL_PRIMARY=us.anthropic.claude-sonnet-4-5-20250929-v1:0
AI_MODEL_FAST=us.amazon.nova-lite-v1:0

# Populated from Secrets Manager in AWS (mechpro/app)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...
SES_FROM_EMAIL=noreply@yourcarguy806.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

